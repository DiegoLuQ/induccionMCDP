# ---------------------------------------------------------------------------
# Base de datos (MySQL 8+). Prisma exige el esquema "mysql://" y el nombre de
# la base de datos en la ruta.
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://usuario:password@localhost:3306/mcdp_induccion"

# ---------------------------------------------------------------------------
# Sesión / Seguridad
# Genera el secreto con: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
APP_URL="http://localhost:3000"

# Vigencia de las invitaciones (horas). Regla de negocio: entre 24 y 48.
INVITATION_TTL_HOURS="48"

# ---------------------------------------------------------------------------
# Correo saliente. Si se omite SMTP_HOST, los correos se imprimen en consola.
# Cuenta por defecto (fallback de todos los colegios).
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# 465 = TLS implícito (SMTPS) -> true. 587 = STARTTLS -> false.
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Inducciones <no-reply@ejemplo.cl>"

# ---------------------------------------------------------------------------
# Remitentes por colegio (opcional). El mailer los resuelve por el dominio
# institucional: el sufijo es el dominio en mayúsculas con "_" en vez de ".".
#   colegiomacaya.cl -> COLEGIOMACAYA_CL
# ---------------------------------------------------------------------------
# SMTP_USER__COLEGIOMACAYA_CL=""
# SMTP_PASSWORD__COLEGIOMACAYA_CL=""
# MAIL_FROM__COLEGIOMACAYA_CL=""

# Copia de consolidados / reportes administrativos.
CONSOLIDADO_TO=""

# ---------------------------------------------------------------------------
# Base de datos externa centralizada (directorio de funcionarios). Obligatoria
# para sincronizar funcionarios; no tiene valores por defecto.
# ---------------------------------------------------------------------------
EXTERNAL_DB_HOST=""
EXTERNAL_DB_PORT="3306"
EXTERNAL_DB_USER=""
EXTERNAL_DB_PASSWORD=""
EXTERNAL_DB_NAME="db_funcionarios"

# ---------------------------------------------------------------------------
# Docker / Producción
# DOMAIN: subdominio público (VIRTUAL_HOST / LETSENCRYPT_HOST / APP_URL).
# DOCKER_DATABASE_URL: reemplaza DATABASE_URL dentro del contenedor, donde
# "localhost" no apunta al MySQL del servidor (usar el nombre del contenedor
# MySQL en red_produccion o la IP del host).
# ---------------------------------------------------------------------------
DOMAIN="induccion.dpmc.cl"
# Correo para registrar el certificado SSL en Let's Encrypt (acme-companion).
LETSENCRYPT_EMAIL="soporte@dpmc.cl"
DOCKER_DATABASE_URL="mysql://USUARIO:PASSWORD@HOST_MYSQL:3306/mcdp_induccion"
